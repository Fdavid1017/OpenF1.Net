<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>OpenF1.Net</Title>
    <Company />
    <Description>.Net wrapper for the https://github.com/br-g/openf1 project</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OpenF1.Net.Tests\**" />
    <EmbeddedResource Remove="OpenF1.Net.Tests\**" />
    <None Remove="OpenF1.Net.Tests\**" />
    <Compile Remove="OpenF1.Net.ManualTests\**" />
    <EmbeddedResource Remove="OpenF1.Net.ManualTests\**" />
    <None Remove="OpenF1.Net.ManualTests\**" />
  </ItemGroup>

</Project>
