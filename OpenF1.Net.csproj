<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>OpenF1.Net</Title>
    <Company />
    <Description>.Net wrapper for the https://github.com/br-g/openf1 project</Description>
    <!-- Fallback for local builds only; the workflows override it with -p:Version=x.y.z.
         VersionPrefix (not Version), so that the version-suffix switch is not ignored either. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <RepositoryUrl>https://github.com/Fdavid1017/OpenF1.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Fdavid1017/OpenF1.Net</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!-- The package release notes come from the RELEASE_NOTES.md generated by git-cliff.
       If the file is not there (a plain local build), the property stays empty. -->
  <Target Name="SetPackageReleaseNotes"
          BeforeTargets="GenerateNuspec"
          Condition="Exists('$(MSBuildProjectDirectory)/RELEASE_NOTES.md')">
    <PropertyGroup>
      <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/RELEASE_NOTES.md'))</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Compile Remove="OpenF1.Net.Tests\**" />
    <EmbeddedResource Remove="OpenF1.Net.Tests\**" />
    <None Remove="OpenF1.Net.Tests\**" />
    <Compile Remove="OpenF1.Net.ManualTests\**" />
    <EmbeddedResource Remove="OpenF1.Net.ManualTests\**" />
    <None Remove="OpenF1.Net.ManualTests\**" />
  </ItemGroup>

</Project>
